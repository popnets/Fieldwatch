    <string name="reports_log_export" translatable="false">日志导出</string>
    <string name="reports_log_export_hint" translatable="false">完整日志：每个无线电一行，含原始广告。CSV/JSON/GPX/KML/WiGLE。</string>
    <string name="reports_sit_export" translatable="false">坐标导出</string>
    <string name="reports_sit_export_hint" translatable="false">仅所选坐标的无线电。CSV/JSON/GPX/KML/WiGLE。</string>
    <string name="reports_ai_export" translatable="false">AI 导出</string>
    <string name="reports_ai_export_sit_hint" translatable="false">所选坐标的结构化摘要，用于粘贴到 LLM。包含解码、车队、飞机、跟随测试。</string>
    <string name="reports_ai_export_compare_hint" translatable="false">两个坐标的结构化对比，用于粘贴到 LLM。</string>
    <string name="reports_format" translatable="false">格式</string>
