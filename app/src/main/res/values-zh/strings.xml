    <string name="reports_signature_candidates">签名候选</string>
    <string name="reports_signature_candidates_desc">从日志重新匹配目录，寻找可提升为签名的家族。需要两个或更多无线电上的唯一在线 ID。</string>

    <!-- Filters Screen -->
    <string name="filters_title">过滤器</string>
    <string name="filters_presets_section">预设</string>
    <string name="filters_presets_desc">点击替换整个过滤器。长按芯片删除它。附带简短内置集；"另存为…"添加你自己的（摄像头、广场 −80 等）。你删除的内置芯片会随设置 → 恢复默认签名和预设回来。</string>
    <string name="filters_save_current_as">另存为…</string>
    <string name="filters_save">保存</string>
    <string name="filters_radios_section">无线电</string>
    <string name="filters_radios_desc_moving">跟随测试仅限 BLE。在你关闭该开关前，"两者"和"仅 Wi-Fi"保持关闭。</string>
    <string name="filters_radios_desc_normal">这些是包含开关。两者都开以同时查看 Wi-Fi 和 BLE。单个设备永远不会两者兼有。</string>
    <string name="filters_both">两者</string>
    <string name="filters_wifi_only">仅 Wi-Fi</string>
    <string name="filters_ble_only">仅 BLE</string>
    <string name="filters_moving_with_you_section">跟随测试</string>
    <string name="filters_moving_with_you">跟随测试</string>
    <string name="filters_moving_with_you_desc_off">开启设置 → 标记检测位置，然后步行或驾驶。仅响亮的始终随你移动的 BLE 广播者。Wi-Fi 接入点保持关闭 —— 你驶过的响亮 AP 会描绘你的路径。开关启动 BLE 跟随测试（清除"仅签名/仅显示"、"仅命名无线电"、"仅关注设备"）。或点击顶部的"跟随测试"预设。</string>
    <string name="filters_moving_with_you_desc_learning" formatted="false">GPS 路径至今 %.0f 米。继续移动（约 50 米）。如果驾驶时仍为 0，位置未给出实时修正（将位置设为高精度）。仅最后已知位置不够。第二台 iPhone 通常不匹配：BLE MAC 轮换开始新无线电。%s%s%s</string>
    <string name="filters_moving_with_you_desc_filtered">GPS 路径 %.0f 米。"仅签名"、"类别仅显示"、"仅命名无线电"或"仅关注设备"也开启，因此只有那些无线电能共同移动。点击"跟随测试"预设测试 BLE。包里的标签或车里的应匹配。Wi-Fi 接入点保持隐藏。</string>
    <string name="filters_moving_with_you_desc_active" formatted="false">GPS 路径 %.0f 米。跟随测试激活。Wi-Fi 接入点隐藏。%s%s%s</string>
    <string name="filters_named_only_on">"仅命名无线电"也开启 —— 未标记无线电保持隐藏。</string>
    <string name="filters_watched_only_on">"仅关注设备"也开启 —— 未关注无线电保持隐藏。</string>
    <string name="filters_named_only_implied_on">"仅签名/仅显示"也开启 —— 未匹配无线电保持隐藏。</string>
    <string name="filters_hide_mine_on">"隐藏我的无线电"开启 —— 那些不在此列表。</string>
    <string name="filters_signatures_section">签名</string>
    <string name="filters_signatures_only">仅签名/仅显示</string>
    <string name="filters_signatures_only_desc">仅显示匹配签名目录的无线电。未匹配的保持隐藏（除非"跟随测试"开启）。</string>
    <string name="filters_show_only">仅显示</string>
    <string name="filters_show_only_desc">仅显示选定类别/签名的无线电。展开类别选择签名。空 = 该类别全部。"跟随测试"开启时此项清除。</string>
    <string name="filters_hide">隐藏</string>
    <string name="filters_hide_desc">隐藏选定类别/签名的无线电。展开类别选择签名。"跟随测试"开启时此项清除。</string>
    <string name="filters_hide_mine">隐藏我的无线电</string>
    <string name="filters_hide_mine_desc">从实时、雷达、时间轴、详情、搜寻、命名无线电和关注列表隐藏标记为"我的"的无线电。日志、匹配、搜寻数学、跟随测试和已保存签名仍使用它们。</string>
    <string name="filters_named_only">仅命名无线电</string>
