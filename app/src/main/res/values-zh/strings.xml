    <string name="reports_signatures_section" translatable="false">签名</string>
    <string name="reports_signature_candidates" translatable="false">签名候选</string>
    <string name="reports_signature_candidates_desc" translatable="false">从日志重新匹配目录，寻找可提升为签名的家族。需要两个或更多无线电上的唯一在线 ID。</string>

    <!-- Filters Screen -->
    <string name="filters_title" translatable="false">过滤器</string>
    <string name="filters_presets_section" translatable="false">预设</string>
    <string name="filters_presets_desc" translatable="false">点击替换整个过滤器。长按芯片删除它。附带简短内置集；"另存为…"添加你自己的（摄像头、广场 −80 等）。你删除的内置芯片会随设置 → 恢复默认签名和预设回来。</string>
    <string name="filters_save_current_as" translatable="false">另存为…</string>
    <string name="filters_save" translatable="false">保存</string>
    <string name="filters_radios_section" translatable="false">无线电</string>
    <string name="filters_radios_desc_moving" translatable="false">跟随测试仅限 BLE。在你关闭该开关前，"两者"和"仅 Wi-Fi"保持关闭。</string>
    <string name="filters_radios_desc_normal" translatable="false">这些是包含开关。两者都开以同时查看 Wi-Fi 和 BLE。单个设备永远不会两者兼有。</string>
    <string name="filters_both" translatable="false">两者</string>
    <string name="filters_wifi_only" translatable="false">仅 Wi-Fi</string>
    <string name="filters_ble_only" translatable="false">仅 BLE</string>
    <string name="filters_moving_with_you_section" translatable="false">跟随测试</string>
    <string name="filters_moving_with_you" translatable="false">跟随测试</string>
    <string name="filters_moving_with_you_desc_off" translatable="false">开启设置 → 标记检测位置，然后步行或驾驶。仅响亮的始终随你移动的 BLE 广播者。Wi-Fi 接入点保持关闭 —— 你驶过的响亮 AP 会描绘你的路径。开关启动 BLE 跟随测试（清除"仅签名/仅显示"、"仅命名无线电"、"仅关注设备"）。或点击顶部的"跟随测试"预设。</string>
    <string name="filters_moving_with_you_desc_learning" formatted="false" translatable="false">GPS 路径至今 %.0f 米。继续移动（约 50 米）。如果驾驶时仍为 0，位置未给出实时修正（将位置设为高精度）。仅最后已知位置不够。第二台 iPhone 通常不匹配：BLE MAC 轮换开始新无线电。%s%s%s</string>
    <string name="filters_moving_with_you_desc_filtered" translatable="false">GPS 路径 %.0f 米。"仅签名"、"类别仅显示"、"仅命名无线电"或"仅关注设备"也开启，因此只有那些无线电能共同移动。点击"跟随测试"预设测试 BLE。包里的标签或车里的应匹配。Wi-Fi 接入点保持隐藏。</string>
    <string name="filters_moving_with_you_desc_active" formatted="false" translatable="false">GPS 路径 %.0f 米。跟随测试激活。Wi-Fi 接入点隐藏。%s%s%s</string>
