    <!-- Reports Screen -->
    <string name="reports_title" translatable="false">报告</string>
    <string name="reports_privacy_mode_notice" translatable="false">隐私模式开启。Debrief、坐标比较、AI 导出（坐标或比较）和详情分享中的 MAC 尾部为 **:**:**。这些报告中的 GPS 坐标和 Remote ID UAS ID 被屏蔽。日志文件、坐标导出和 GPX/KML/WiGLE 文件仍包含完整地址和经纬度。</string>
    <string name="reports_sits_section" translatable="false">坐标</string>
    <string name="reports_sits_desc" translatable="false">坐标是此处听到的无线电的命名时间窗。下方选择驱动路径、Debrief 和比较的"此坐标"侧：打开的坐标、选定的已保存坐标，或从未开始则为最近 15 分钟。</string>
    <string name="reports_this_sit" formatted="false" translatable="false">此坐标：%s · %s · %d 个无线电</string>
    <string name="reports_end_sit" translatable="false">结束坐标</string>
    <string name="reports_start_sit" translatable="false">开始坐标</string>
    <string name="reports_no_sit_running" translatable="false">未运行坐标。在此开始坐标。路径和 Debrief 保持最近 15 分钟直到你开始。</string>
    <string name="reports_no_sit_running_with_saved" translatable="false">未运行坐标。在此开始坐标。路径和 Debrief 使用选定的坐标。</string>
    <string name="reports_no_saved_sits" translatable="false">无已保存坐标。</string>
    <string name="reports_last_15_minutes" translatable="false">最近 15 分钟</string>
    <string name="reports_last_15_minutes_desc" translatable="false">路径和 Debrief 使用内存，而非已保存的坐标。</string>
    <string name="reports_sit_subtitle_format" formatted="false" translatable="false">%s · %s · %d 个无线电%s</string>
    <string name="reports_extra_attention" translatable="false"> · 额外关注 %d</string>
    <string name="reports_end_sit_to_pick" translatable="false">结束坐标以选取已保存的坐标用于路径和 Debrief。</string>
    <string name="reports_rename" translatable="false">重命名</string>
    <string name="reports_delete" translatable="false">删除</string>
    <string name="reports_delete_all_sits" translatable="false">删除所有坐标</string>
    <string name="reports_delete_all_confirm" translatable="false">删除所有坐标？</string>
    <string name="reports_path_section" translatable="false">路径</string>
    <string name="reports_path_desc" translatable="false">北向上。线条是此手机。黑点是起点。蓝点是你，在最后一点。MAC 或签名警报是一个类别图标。解码的经纬度使用该无线电发送的最后位置。计数是同一位置的多个。粗绿线是停留。时间刻度沿路径分布。</string>
    <string name="reports_path_privacy_mode" translatable="false">隐私模式开启 · 地图隐藏。在设置中关闭以显示地图。</string>
    <string name="reports_path_no_gps" translatable="false">无 GPS 点可绘制路径。</string>
    <string name="reports_debrief_section" translatable="false">Debrief</string>
    <string name="reports_debrief_desc" translatable="false">所选坐标的叙述摘要。在线地名和地图开启时包含街道名称。模式匹配，非身份识别。非安全发现。</string>
    <string name="reports_debrief_generate" translatable="false">生成 Debrief</string>
    <string name="reports_debrief_this_sit_format" formatted="false" translatable="false">此坐标：%s — 命名窗口（最多 %d）。与 Debrief 相同。</string>
    <string name="reports_compare_section" translatable="false">比较</string>
    <string name="reports_compare_desc" translatable="false">两个坐标并列：MAC、类别、信号、首次/最近、解码、车队、飞机。模式匹配，非身份识别。非安全发现。</string>
    <string name="reports_compare_with" translatable="false">比较目标</string>
    <string name="reports_compare_this_sit_format" formatted="false" translatable="false">此坐标：%s — 命名窗口（最多 %d）。与 Debrief 相同。</string>
    <string name="reports_compare_other_sit_format" formatted="false" translatable="false">其他坐标：%s — 命名窗口（最多 %d）。</string>
    <string name="reports_compare_last_15" translatable="false">此坐标：内存中最近 15 分钟（约 400 个无线电）。与 Debrief 相同。</string>
    <string name="reports_compare_generate" translatable="false">生成比较</string>
