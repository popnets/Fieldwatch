    <!-- Settings Screen -->
    <string name="settings_title">设置</string>
    <string name="settings_appearance">外观</string>
    <string name="settings_night_mode">夜间模式</string>
    <string name="settings_night_mode_desc">默认关闭。红底黑字的现场显示，使芯片、文本和信号标记不会在黑暗坐标中泄漏绿色或蓝色。背景保持深色。手机亮度不变。</string>
    <string name="settings_keep_screen_on">保持屏幕常亮</string>
    <string name="settings_keep_screen_on_desc">默认开启。Fieldwatch 打开时阻止显示休眠，这样手机熄屏时 BLE 不会被挂起。离开应用后扫描仍在通知中运行。把手机放进口袋时关闭它。</string>
    <string name="settings_privacy_mode">隐私模式</string>
    <string name="settings_privacy_mode_desc">在实时、雷达、时间轴、详情、搜寻、命名无线电和关注列表卡片上隐藏每个 MAC 的后三个八位组为 **:**:**，这样屏幕和坐标报告不显示完整地址。GPS 最近定位和 Debrief / AI 导出 / 详情分享的坐标变为"已屏蔽"；这些坐标报告中省略街道名称。前三个八位组（OUI/厂商前缀）保留。默认关闭。开启"在线地名和地图"时，报告 → 路径上的地图仍会加载。日志、匹配、过滤器、搜寻数学、跟随测试和已保存签名仍使用真实 MAC 和 GPS。如果你开启了 TAK / CoT 馈送，开启此项时会暂停，这样完整 MAC 和坐标不会发送到局域网。需要屏幕上显示完整地址或坐标时关闭此项。</string>
    <string name="settings_scanning">扫描</string>
    <string name="settings_scan_intensity">扫描强度 · %s</string>
    <string name="settings_scan_saver">省电模式</string>
    <string name="settings_scan_balanced">均衡</string>
    <string name="settings_scan_performance">高性能</string>
    <string name="settings_scan_intensity_desc">Wi-Fi 是批量无线电：手机一次抓取所有 AP，然后必须等待。高性能约每 30 秒请求一次 —— 这是在 OS 限制的两分钟四次扫描下能保持的最快节奏。BLE 在间隙中持续流式传输。</string>
    <string name="settings_wifi_waiting_os">Wi-Fi 等待 OS</string>
    <string name="settings_wifi_scanning">Wi-Fi 正在扫描</string>
    <string name="settings_wifi_next_99s">Wi-Fi 下一次 99 秒</string>
    <string name="settings_faster_wifi_scans">更快的 Wi-Fi AP 扫描</string>
    <string name="settings_faster_wifi_scans_desc_old">需要 Android 11+ 以便 Fieldwatch 读取 OS 是否仍在限制扫描。此手机无法确认，因此开关保持关闭。</string>
    <string name="settings_faster_wifi_scans_desc_active">已激活。手机每约 10 秒扫描一次 Wi-Fi AP，而不是约 30 秒。当 OS 限制生效时会自动关闭（见下方）。</string>
    <string name="settings_faster_wifi_scans_desc_throttled">OS 正在限制扫描。在开发者选项中关闭"Wi-Fi 扫描限制"后，此开关才会生效。</string>
    <string name="settings_faster_wifi_scans_desc_dev_options">在开发者选项中关闭"Wi-Fi 扫描限制"以启用更快的扫描。某些 OEM 将其放在网络/互联网 → Wi-Fi → Wi-Fi 首选项 → 高级 → Wi-Fi 扫描限制。</string>
    <string name="settings_ble_settings">蓝牙 LE 设置</string>
    <string name="settings_ble_background">后台 BLE 扫描</string>
    <string name="settings_ble_background_desc">默认开启。应用在后台或屏幕关闭时继续扫描 BLE 广播。通知会保持可见。关闭以在后台停止 BLE。</string>
    <string name="settings_ble_duplicate_filter">BLE 去重过滤</string>
    <string name="settings_ble_duplicate_filter_desc">默认开启。在扫描回调中去除重复广播，减少相同数据的重复处理。关闭可看到每个原始回调。</string>
    <string name="settings_ble_long_range">BLE 远距离模式 (PHY 编码)</string>
    <string name="settings_ble_long_range_desc">默认关闭。请求编码 PHY (LE Coded) 以获得更远范围，吞吐量更低。并非所有控制器都支持。</string>
    <string name="settings_battery_optimization">电池优化</string>
    <string name="settings_battery_optimization_desc">某些 OEM 即使开启了"忽略电池优化"也会在后台限制 BLE。如果扫描在口袋里停止，请打开应用电池页面并选择"无限制"或"允许后台使用"。</string>
    <string name="settings_open_battery_page">打开应用电池页面</string>
    <string name="settings_open_battery_page_unrestricted">打开应用电池页面 (无限制)</string>
    <string name="settings_background_restricted">后台受限：%s</string>
    <string name="settings_background_allowed">后台允许：%s</string>
    <string name="settings_unrestricted">无限制：%s</string>
    <string name="settings_yes">是</string>
    <string name="settings_no">否</string>
    <string name="settings_tag_location">标记检测位置 (GPS)</string>
    <string name="settings_tag_location_desc">开启时，每次检测记录手机的 GPS 修正（若可用）。坐标报告、GPX/KML/WiGLE 和 AI 导出将包含位置。实时列表显示"首次/最近"时间；详情显示首次/最近坐标。关闭以停止记录位置；现有日志保留坐标。即使开启，如果 OS 未给出修正（如室内），也不会写入坐标。</string>
    <string name="settings_online_maps">在线地名和地图</string>
    <string name="settings_online_maps_desc">开启时，报告 → 路径使用系统地理编码器（通常为 OEM/Google 网络）显示街道名称和地图瓦片。离线时坐标仍在日志/导出中。这是发往系统地理编码器的网络请求，不是 Fieldwatch 云端。</string>
    <string name="settings_log_export">日志导出</string>
    <string name="settings_export_signatures">导出签名</string>
    <string name="settings_import_signatures">导入签名</string>
    <string name="settings_export_settings">导出设置</string>
    <string name="settings_import_settings">导入设置</string>
    <string name="settings_restore_defaults">恢复默认签名和预设</string>
    <string name="settings_restore_defaults_desc">把内置签名目录和过滤器预设恢复为出厂状态。你添加的签名和保存的预设会被删除。日志、坐标、命名无线电、关注列表、车队和设置不受影响。</string>
    <string name="settings_restore_confirm">恢复默认签名和预设？</string>
    <string name="settings_restore_confirm_body">这会删除你添加的签名和保存的预设。日志、坐标、命名无线电、关注列表、车队和设置不受影响。</string>
    <string name="settings_restore">恢复</string>
    <string name="settings_cancel">取消</string>
    <string name="settings_clear_log">清除日志</string>
    <string name="settings_clear_log_desc">删除所有记录的无线电和坐标。已保存的坐标、命名无线电、关注列表、车队、签名和设置不受影响。</string>
    <string name="settings_clear_log_confirm">清除日志？</string>
    <string name="settings_clear_log_confirm_body">删除所有记录的无线电和坐标。已保存的坐标、命名无线电、关注列表、车队、签名和设置不受影响。</string>
    <string name="settings_clear">清除</string>
    <string name="settings_diagnostics">诊断</string>
    <string name="settings_diagnostics_desc">列出手机、无线电和扫描选项。</string>
    <string name="settings_about">关于</string>
    <string name="settings_version" formatted="false">版本 %s (%d)</string>
    <string name="settings_license">MIT 许可证</string>
    <string name="settings_github">GitHub</string>
    <string name="settings_manual">用户手册</string>
    <string name="settings_disclaimer">免责声明</string>
    <string name="settings_acknowledgments">致谢</string>

    <!-- Reports Screen -->
    <string name="reports_title">报告</string>
    <string name="reports_privacy_mode_notice">隐私模式开启。Debrief、坐标比较、AI 导出（坐标或比较）和详情分享中的 MAC 尾部为 **:**:**。这些报告中的 GPS 坐标和 Remote ID UAS ID 被屏蔽。日志文件、坐标导出和 GPX/KML/WiGLE 文件仍包含完整地址和经纬度。</string>
    <string name="reports_sits_section">坐标</string>
    <string name="reports_sits_desc">坐标是此处听到的无线电的命名时间窗。下方选择驱动路径、Debrief 和比较的"此坐标"侧：打开的坐标、选定的已保存坐标，或从未开始则为最近 15 分钟。</string>
    <string name="reports_this_sit" formatted="false">此坐标：%s · %s · %d 个无线电</string>
    <string name="reports_end_sit">结束坐标</string>
    <string name="reports_start_sit">开始坐标</string>
    <string name="reports_no_sit_running">未运行坐标。在此开始坐标。路径和 Debrief 保持最近 15 分钟直到你开始。</string>
    <string name="reports_no_sit_running_with_saved">未运行坐标。在此开始坐标。路径和 Debrief 使用选定的坐标。</string>
    <string name="reports_no_saved_sits">无已保存坐标。</string>
    <string name="reports_last_15_minutes">最近 15 分钟</string>
    <string name="reports_last_15_minutes_desc">路径和 Debrief 使用内存，而非已保存的坐标。</string>
    <string name="reports_sit_subtitle_format" formatted="false">%s · %s · %d 个无线电%s</string>
    <string name="reports_extra_attention"> · 额外关注 %d</string>
    <string name="reports_end_sit_to_pick">结束坐标以选取已保存的坐标用于路径和 Debrief。</string>
    <string name="reports_rename">重命名</string>
    <string name="reports_delete">删除</string>
    <string name="reports_delete_all_sits">删除所有坐标</string>
    <string name="reports_delete_all_confirm">删除所有坐标？</string>
    <string name="reports_path_section">路径</string>
    <string name="reports_path_desc">北向上。线条是此手机。黑点是起点。蓝点是你，在最后一点。MAC 或签名警报是一个类别图标。解码的经纬度使用该无线电发送的最后位置。计数是同一位置的多个。粗绿线是停留。时间刻度沿路径分布。</string>
    <string name="reports_path_privacy_mode">隐私模式开启 · 地图隐藏。在设置中关闭以显示地图。</string>
    <string name="reports_path_no_gps">无 GPS 点可绘制路径。</string>
    <string name="reports_debrief_section">Debrief</string>
    <string name="reports_debrief_desc">所选坐标的叙述摘要。在线地名和地图开启时包含街道名称。模式匹配，非身份识别。非安全发现。</string>
    <string name="reports_debrief_generate">生成 Debrief</string>
    <string name="reports_debrief_this_sit_format" formatted="false">此坐标：%s — 命名窗口（最多 %d）。与 Debrief 相同。</string>
    <string name="reports_compare_section">比较</string>
    <string name="reports_compare_desc">两个坐标并列：MAC、类别、信号、首次/最近、解码、车队、飞机。模式匹配，非身份识别。非安全发现。</string>
    <string name="reports_compare_with">比较目标</string>
    <string name="reports_compare_this_sit_format" formatted="false">此坐标：%s — 命名窗口（最多 %d）。与 Debrief 相同。</string>
    <string name="reports_compare_other_sit_format" formatted="false">其他坐标：%s — 命名窗口（最多 %d）。</string>
    <string name="reports_compare_last_15">此坐标：内存中最近 15 分钟（约 400 个无线电）。与 Debrief 相同。</string>
    <string name="reports_compare_generate">生成比较</string>
    <string name="reports_export_section">导出</string>
    <string name="reports_log_export">日志导出</string>
    <string name="reports_log_export_hint">完整日志：每个无线电一行，含原始广告。CSV/JSON/GPX/KML/WiGLE。</string>
    <string name="reports_sit_export">坐标导出</string>
    <string name="reports_sit_export_hint">仅所选坐标的无线电。CSV/JSON/GPX/KML/WiGLE。</string>
