    <!-- Settings Screen -->
    <string name="settings_title" translatable="false">设置</string>
    <string name="settings_appearance" translatable="false">外观</string>
    <string name="settings_night_mode" translatable="false">夜间模式</string>
    <string name="settings_night_mode_desc" translatable="false">默认关闭。红底黑字的现场显示，使芯片、文本和信号标记不会在黑暗坐标中泄漏绿色或蓝色。背景保持深色。手机亮度不变。</string>
    <string name="settings_keep_screen_on" translatable="false">保持屏幕常亮</string>
    <string name="settings_keep_screen_on_desc" translatable="false">默认开启。Fieldwatch 打开时阻止显示休眠，这样手机熄屏时 BLE 不会被挂起。离开应用后扫描仍在通知中运行。把手机放进口袋时关闭它。</string>
    <string name="settings_privacy_mode" translatable="false">隐私模式</string>
    <string name="settings_privacy_mode_desc" translatable="false">在实时、雷达、时间轴、详情、搜寻、命名无线电和关注列表卡片上隐藏每个 MAC 的后三个八位组为 **:**:**，这样屏幕和坐标报告不显示完整地址。GPS 最近定位和 Debrief / AI 导出 / 详情分享的坐标变为"已屏蔽"；这些坐标报告中省略街道名称。前三个八位组（OUI/厂商前缀）保留。默认关闭。开启"在线地名和地图"时，报告 → 路径上的地图仍会加载。日志、匹配、过滤器、搜寻数学、跟随测试和已保存签名仍使用真实 MAC 和 GPS。如果你开启了 TAK / CoT 馈送，开启此项时会暂停，这样完整 MAC 和坐标不会发送到局域网。需要屏幕上显示完整地址或坐标时关闭此项。</string>
    <string name="settings_scanning" translatable="false">扫描</string>
    <string name="settings_scan_intensity" translatable="false">扫描强度 · %s</string>
    <string name="settings_scan_saver" translatable="false">省电模式</string>
    <string name="settings_scan_balanced" translatable="false">均衡</string>
    <string name="settings_scan_performance" translatable="false">高性能</string>
    <string name="settings_scan_intensity_desc" translatable="false">Wi-Fi 是批量无线电：手机一次抓取所有 AP，然后必须等待。高性能约每 30 秒请求一次 —— 这是在 OS 限制的两分钟四次扫描下能保持的最快节奏。BLE 在间隙中持续流式传输。</string>
    <string name="settings_wifi_waiting_os" translatable="false">Wi-Fi 等待 OS</string>
    <string name="settings_wifi_scanning" translatable="false">Wi-Fi 正在扫描</string>
    <string name="settings_wifi_next_99s" translatable="false">Wi-Fi 下一次 99 秒</string>
    <string name="settings_faster_wifi_scans" translatable="false">更快的 Wi-Fi AP 扫描</string>
    <string name="settings_faster_wifi_scans_desc_old" translatable="false">需要 Android 11+ 以便 Fieldwatch 读取 OS 是否仍在限制扫描。此手机无法确认，因此开关保持关闭。</string>
    <string name="settings_faster_wifi_scans_desc_active" translatable="false">已激活。手机每约 10 秒扫描一次 Wi-Fi AP，而不是约 30 秒。当 OS 限制生效时会自动关闭（见下方）。</string>
    <string name="settings_faster_wifi_scans_desc_throttled" translatable="false">OS 正在限制扫描。在开发者选项中关闭"Wi-Fi 扫描限制"后，此开关才会生效。</string>
    <string name="settings_faster_wifi_scans_desc_dev_options" translatable="false">在开发者选项中关闭"Wi-Fi 扫描限制"以启用更快的扫描。某些 OEM 将其放在网络/互联网 → Wi-Fi → Wi-Fi 首选项 → 高级 → Wi-Fi 扫描限制。</string>
    <string name="settings_ble_settings" translatable="false">蓝牙 LE 设置</string>
    <string name="settings_ble_background" translatable="false">后台 BLE 扫描</string>
    <string name="settings_ble_background_desc" translatable="false">默认开启。应用在后台或屏幕关闭时继续扫描 BLE 广播。通知会保持可见。关闭以在后台停止 BLE。</string>
    <string name="settings_ble_duplicate_filter" translatable="false">BLE 去重过滤</string>
    <string name="settings_ble_duplicate_filter_desc" translatable="false">默认开启。在扫描回调中去除重复广播，减少相同数据的重复处理。关闭可看到每个原始回调。</string>
    <string name="settings_ble_long_range" translatable="false">BLE 远距离模式 (PHY 编码)</string>
    <string name="settings_ble_long_range_desc" translatable="false">默认关闭。请求编码 PHY (LE Coded) 以获得更远范围，吞吐量更低。并非所有控制器都支持。</string>
    <string name="settings_battery_optimization" translatable="false">电池优化</string>
    <string name="settings_battery_optimization_desc" translatable="false">某些 OEM 即使开启了"忽略电池优化"也会在后台限制 BLE。如果扫描在口袋里停止，请打开应用电池页面并选择"无限制"或"允许后台使用"。</string>
    <string name="settings_open_battery_page" translatable="false">打开应用电池页面</string>
    <string name="settings_open_battery_page_unrestricted" translatable="false">打开应用电池页面 (无限制)</string>
    <string name="settings_background_restricted" translatable="false">后台受限：%s</string>
    <string name="settings_background_allowed" translatable="false">后台允许：%s</string>
    <string name="settings_unrestricted" translatable="false">无限制：%s</string>
    <string name="settings_yes" translatable="false">是</string>
    <string name="settings_no" translatable="false">否</string>
    <string name="settings_tag_location" translatable="false">标记检测位置 (GPS)</string>
    <string name="settings_tag_location_desc" translatable="false">开启时，每次检测记录手机的 GPS 修正（若可用）。坐标报告、GPX/KML/WiGLE 和 AI 导出将包含位置。实时列表显示"首次/最近"时间；详情显示首次/最近坐标。关闭以停止记录位置；现有日志保留坐标。即使开启，如果 OS 未给出修正（如室内），也不会写入坐标。</string>
    <string name="settings_online_maps" translatable="false">在线地名和地图</string>
    <string name="settings_online_maps_desc" translatable="false">开启时，报告 → 路径使用系统地理编码器（通常为 OEM/Google 网络）显示街道名称和地图瓦片。离线时坐标仍在日志/导出中。这是发往系统地理编码器的网络请求，不是 Fieldwatch 云端。</string>
    <string name="settings_log_export" translatable="false">日志导出</string>
    <string name="settings_export_signatures" translatable="false">导出签名</string>
    <string name="settings_import_signatures" translatable="false">导入签名</string>
    <string name="settings_export_settings" translatable="false">导出设置</string>
    <string name="settings_import_settings" translatable="false">导入设置</string>
    <string name="settings_restore_defaults" translatable="false">恢复默认签名和预设</string>
    <string name="settings_restore_defaults_desc" translatable="false">把内置签名目录和过滤器预设恢复为出厂状态。你添加的签名和保存的预设会被删除。日志、坐标、命名无线电、关注列表、车队和设置不受影响。</string>
    <string name="settings_restore_confirm" translatable="false">恢复默认签名和预设？</string>
    <string name="settings_restore_confirm_body" translatable="false">这会删除你添加的签名和保存的预设。日志、坐标、命名无线电、关注列表、车队和设置不受影响。</string>
    <string name="settings_restore" translatable="false">恢复</string>
    <string name="settings_cancel" translatable="false">取消</string>
    <string name="settings_clear_log" translatable="false">清除日志</string>
    <string name="settings_clear_log_desc" translatable="false">删除所有记录的无线电和坐标。已保存的坐标、命名无线电、关注列表、车队、签名和设置不受影响。</string>
    <string name="settings_clear_log_confirm" translatable="false">清除日志？</string>
    <string name="settings_clear_log_confirm_body" translatable="false">删除所有记录的无线电和坐标。已保存的坐标、命名无线电、关注列表、车队、签名和设置不受影响。</string>
    <string name="settings_clear" translatable="false">清除</string>
    <string name="settings_diagnostics" translatable="false">诊断</string>
    <string name="settings_diagnostics_desc" translatable="false">列出手机、无线电和扫描选项。</string>
    <string name="settings_about" translatable="false">关于</string>
    <string name="settings_version" formatted="false" translatable="false">版本 %s (%d)</string>
