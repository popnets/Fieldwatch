    <string name="filters_title">Filters</string>
    <string name="filters_presets_section">Presets</string>
    <string name="filters_presets_desc">Tap to replace whole filter. Long-press chip to delete. Short stock set ships; Save current as… adds yours (Cameras, plaza −80, …). Stock chips you delete come back with Settings → Restore default signatures &amp; presets.</string>
    <string name="filters_save_current_as">Save current as…</string>
