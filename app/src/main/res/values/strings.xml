    <string name="filters_radios_section">Radios</string>
    <string name="filters_radios_desc_moving">Moving with you is BLE only. Both and Wi-Fi only stay off until you turn that switch off.</string>
    <string name="filters_radios_desc_normal">These are include switches. Turn both on to see Wi-Fi and BLE together. A single device is never both.</string>
