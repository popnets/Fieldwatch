    <string name="filters_moving_with_you_section">Moving with you</string>
    <string name="filters_moving_with_you">Moving with you</string>
    <string name="filters_moving_with_you_desc_off">Turn on Settings → Tag detections with GPS, then walk or drive. Only loud BLE advertisers that stay with you along the path. Wi-Fi access points stay off — a loud AP you drive past paints your path. The switch starts a BLE follow test (clears Signatures only / Show only / Named radios only / Watched only). Or tap the Moving with you preset at the top.</string>
    <string name="filters_moving_with_you_desc_learning">GPS path so far %.0f m. Keep moving (~50 m). If this stays 0 while you drive, Location not giving live fix (set Location to high accuracy). Last-known-only not enough. Second iPhone usually won't match: BLE MAC rotation starts new radio.%s%s%s</string>
    <string name="filters_moving_with_you_desc_filtered">GPS path %.0f m. Signatures only, class Show only, Named radios only, or Watched only also on, so only those radios can co-travel. Tap Moving with you preset to test BLE. Tag in bag or car should match. Wi-Fi APs stay hidden.</string>
    <string name="filters_moving_with_you_desc_active">GPS path %.0f m. Follow test active. Wi-Fi APs hidden.%s%s%s</string>
    <string name="filters_named_only_on">Named radios only also on — unlabeled radios stay hidden.</string>
    <string name="filters_watched_only_on">Watched only also on — unwatched radios stay hidden.</string>
    <string name="filters_named_only_implied_on">Signatures only / Show only also on — unmatched radios stay hidden.</string>
    <string name="filters_hide_mine_on">Hide my radios on — those stay off this list.</string>
    <string name="filters_signatures_section">Signatures</string>
    <string name="filters_signatures_only">Signatures only / Show only</string>
    <string name="filters_signatures_only_desc">Only show radios matching signature catalog. Unmatched stay hidden (unless Moving with you on).</string>
    <string name="filters_show_only">Show only</string>
    <string name="filters_show_only_desc">Only show selected classes/signatures. Expand class to pick signatures. Empty = all in class. Cleared when Moving with you on.</string>
    <string name="filters_hide">Hide</string>
    <string name="filters_hide_desc">Hide selected classes/signatures. Expand class to pick signatures. Cleared when Moving with you on.</string>
    <string name="filters_hide_mine">Hide my radios</string>
    <string name="filters_hide_mine_desc">Hides radios marked Mine from Live, radar, timeline, detail, Hunt, Named radios, and watchlist. Logs, matching, Hunt math, Moving with you, and saved signatures still use them.</string>
    <string name="filters_named_only">Named radios only</string>
    <string name="filters_named_only_desc">Only show radios with custom name or advertised name. All others hidden. Cleared when Moving with you on.</string>
    <string name="filters_watched_only">Watched only</string>
    <string name="filters_watched_only_desc">Only show radios on watchlist. All others hidden. Cleared when Moving with you on.</string>
    <string name="filters_arrivals_only">New only</string>
    <string name="filters_arrivals_only_desc">Only show radios first seen since this switch turned on. Known radios hidden. Counter shows when learning silent Wi-Fi. Cleared when Moving with you on.</string>
