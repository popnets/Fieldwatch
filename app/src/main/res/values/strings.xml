    <string name="settings_title">Settings</string>
    <string name="settings_appearance">Appearance</string>
    <string name="settings_night_mode">Night mode</string>
    <string name="settings_night_mode_desc">Off by default. Red-on-black field display so chips, text, and signal marks do not dump green or blue into a dark sit. Background stays dark. Phone brightness unchanged.</string>
    <string name="settings_keep_screen_on">Keep screen on</string>
    <string name="settings_keep_screen_on_desc">On by default. Stops display from sleeping while Fieldwatch is open so BLE is not parked when phone blanks. Scanning still runs in notification if you leave the app. Turn off when pocketing phone.</string>
    <string name="settings_privacy_mode">Privacy mode</string>
    <string name="settings_privacy_mode_desc">Hides last three octets of every MAC on Live, radar, timeline, detail, Hunt, Named radios, and watchlist cards as **:**:** so screen and sit reports do not show full addresses. GPS last-fix and Debrief / AI Export / detail Share coordinates become \"masked\"; street names omitted from those sit reports. First three octets (OUI / vendor prefix) stay. Off by default. Map on Reports → Path still loads when Online place names and maps is on. Logs, matching, filters, Hunt math, Moving with you, and saved signatures still use real MAC and GPS. A TAK / CoT feed, if you turned it on, is paused while this is on so full MACs and coordinates are not sent onto LAN. Turn off when you need full address or coordinates on screen.</string>
    <string name="settings_scanning">Scanning</string>
    <string name="settings_scan_intensity">Scan intensity · %s</string>
    <string name="settings_scan_saver">Battery saver</string>
    <string name="settings_scan_balanced">Balanced</string>
    <string name="settings_scan_performance">High performance</string>
    <string name="settings_scan_intensity_desc">Wi-Fi is a batch radio: phone grabs all APs at once, then must wait. High performance asks ~every 30s — fastest cadence under OS limit of four scans per two minutes. BLE still streams in between.</string>
    <string name="settings_wifi_waiting_os">Wi-Fi waiting on OS</string>
    <string name="settings_wifi_scanning">Wi-Fi scanning</string>
    <string name="settings_wifi_next_99s">Wi-Fi next 99s</string>
    <string name="settings_faster_wifi_scans">Faster Wi-Fi AP scans</string>
    <string name="settings_faster_wifi_scans_desc_old">Needs Android 11+ so Fieldwatch can read whether OS is still throttling scans. This phone cannot confirm, so switch stays off.</string>
    <string name="settings_faster_wifi_scans_desc_active">Activated. Phone scans Wi-Fi AP ~every 10s instead of ~30s. Auto-off when OS throttle takes effect (see below).</string>
    <string name="settings_faster_wifi_scans_desc_throttled">OS throttling scans. Turn off Wi-Fi scan throttling in Developer options for switch to take effect.</string>
    <string name="settings_faster_wifi_scans_desc_dev_options">Turn off Wi-Fi scan throttling in Developer options to enable faster scans. Some OEMs place it under Network/Internet → Wi-Fi → Wi-Fi preferences → Advanced → Wi-Fi scan throttling.</string>
    <string name="settings_ble_settings">Bluetooth LE settings</string>
    <string name="settings_ble_background">Background BLE scanning</string>
    <string name="settings_ble_background_desc">On by default. App keeps scanning BLE ads in background or screen off. Notification stays visible. Turn off to stop BLE in background.</string>
    <string name="settings_ble_duplicate_filter">BLE duplicate filter</string>
    <string name="settings_ble_duplicate_filter_desc">On by default. Deduplicates adverts in scan callback, reducing duplicate processing of same data. Turn off to see every raw callback.</string>
    <string name="settings_ble_long_range">BLE long range (PHY coded)</string>
    <string name="settings_ble_long_range_desc">Off by default. Requests coded PHY (LE Coded) for longer range, lower throughput. Not all controllers support it.</string>
    <string name="settings_battery_optimization">Battery optimization</string>
    <string name="settings_battery_optimization_desc">Some OEMs restrict BLE in background even with Ignore battery optimization on. If scanning stops in pocket, open app battery page and pick Unrestricted or Allow background usage.</string>
    <string name="settings_open_battery_page">Open app battery page</string>
    <string name="settings_open_battery_page_unrestricted">Open app battery page (unrestricted)</string>
    <string name="settings_background_restricted">Background restricted: %s</string>
    <string name="settings_background_allowed">Background allowed: %s</string>
    <string name="settings_unrestricted">Unrestricted: %s</string>
    <string name="settings_yes">Yes</string>
    <string name="settings_no">No</string>
    <string name="settings_tag_location">Tag detections with GPS</string>
    <string name="settings_tag_location_desc">When on, every detection logs phone's GPS fix (if available). Sit reports, GPX/KML/WiGLE, and AI Export will include location. Live list shows first/last times; detail shows first/last coords. Turn off to stop logging location; existing logs keep coords. Even when on, no coords written if OS gives no fix (e.g., indoors).</string>
    <string name="settings_online_maps">Online place names and maps</string>
    <string name="settings_online_maps_desc">On by default. Reports → Path uses system geocoder (usually OEM/Google) for street names and map tiles. Offline coords still in logs/exports. This is a network request to system geocoder, not a Fieldwatch cloud.</string>
